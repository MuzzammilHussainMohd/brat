<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GlucoSense Viewer"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Device list container -->
    <LinearLayout
        android:id="@+id/deviceListContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="8dp">

        <!-- Scanning status - shown while scanning -->
        <TextView
            android:id="@+id/scanningStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scanning for devices..."
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:padding="12dp" />

    </LinearLayout>

    <!-- Connection status -->
    <TextView
        android:id="@+id/connectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:padding="8dp" />

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Large glucose display -->
    <TextView
        android:id="@+id/glucoseValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="---"
        android:textSize="100sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center" />

    <TextView
        android:id="@+id/glucoseUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="mg/dL"
        android:textSize="28sp"
        android:textColor="#666666"
        android:gravity="center" />

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Alarm state banner -->
    <TextView
        android:id="@+id/alarmBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Waiting for data..."
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="16dp"
        android:background="#888888" />

    <!-- Silence alarm button -->
    <Button
        android:id="@+id/silenceAlarmBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Silence Alarm"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="#607D8B"
        android:padding="12dp"
        android:layout_marginTop="8dp" />

    <!-- Error message area -->
    <TextView
        android:id="@+id/errorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#CC0000"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone" />

</LinearLayout>
